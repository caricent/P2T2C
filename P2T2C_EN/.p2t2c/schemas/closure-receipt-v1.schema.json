{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p2t2c.dev/schemas/closure-receipt-v1.schema.json",
  "title": "P2T2C local-consistency closure receipt v1",
  "type": "object",
  "required": [
    "schema_version", "receipt_type", "evidence_trust", "work_id", "risk",
    "execution_shape", "contract_digest", "production_code_change", "multi_agent",
    "implementer", "tdd_policy",
    "governance_change", "specialist_review_required", "gate_a", "truth_patch_ref",
    "truth_patch_digest", "ownership_batches", "legacy_startup_evidence",
    "gate_b_status", "gate_b_decision", "gate_b_ref", "event_count",
    "source_digest", "final_tree_sha", "head_sha", "evidence_target",
    "tree_excludes", "verification_profile", "verification_requirements",
    "route_final_risk", "route_final_shape", "tdd_evidence", "isolation_required",
    "gate_b_event_required", "review_roles", "max_repair_round",
    "methodology_enforcement", "evidence_completeness", "evidence_warnings",
    "path_mapping_digest", "matched_profiles", "matched_paths_digest", "baseline_sha",
    "remaining_risk_status", "remaining_risk_ref", "closed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_type": { "const": "closure" },
    "evidence_trust": { "const": "local_consistency" },
    "work_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "risk": { "enum": ["R0", "R1", "R2"] },
    "execution_shape": { "enum": ["bounded", "architectural"] },
    "contract_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "production_code_change": { "type": "boolean" },
    "multi_agent": { "type": "boolean" },
    "implementer": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tdd_policy": { "enum": ["required", "exempt", "not_applicable"] },
    "governance_change": { "type": "boolean" },
    "specialist_review_required": { "type": "boolean" },
    "gate_a": { "enum": ["not_required", "satisfied"] },
    "truth_patch_ref": { "type": "string", "minLength": 1 },
    "truth_patch_digest": { "oneOf": [{ "const": "none" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
    "ownership_batches": { "type": "string", "minLength": 1 },
    "legacy_startup_evidence": { "type": "boolean" },
    "gate_b_status": { "enum": ["not_triggered", "resolved"] },
    "gate_b_decision": { "type": "string", "minLength": 1 },
    "gate_b_ref": { "type": "string", "minLength": 1 },
    "event_count": { "type": "integer", "minimum": 1 },
    "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "final_tree_sha": { "$ref": "#/$defs/gitOid" },
    "head_sha": { "$ref": "#/$defs/gitOid" },
    "evidence_target": { "$ref": "#/$defs/evidenceTarget" },
    "tree_excludes": {
      "type": "array",
      "prefixItems": [{ "const": ".p2t2c/runs/**" }, { "$ref": "#/$defs/evidenceTarget" }],
      "minItems": 2,
      "maxItems": 2
    },
    "verification_profile": { "enum": ["fast", "impacted", "full", "governance"] },
    "verification_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profile", "profile_config_digest", "command_ids"],
        "properties": {
          "profile": { "enum": ["fast", "impacted", "full", "governance"] },
          "profile_config_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "command_ids": {
            "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
          }
        },
        "additionalProperties": false
      }
    },
    "route_final_risk": { "enum": ["R0", "R1", "R2"] },
    "route_final_shape": { "enum": ["bounded", "architectural"] },
    "tdd_evidence": { "enum": ["red_green", "exemption", "not_applicable", "advisory_missing"] },
    "isolation_required": { "type": "boolean" },
    "gate_b_event_required": { "type": "boolean" },
    "review_roles": { "type": "array", "items": { "enum": ["batch", "global", "specialist", "re_review"] }, "uniqueItems": true },
    "reviewer": { "type": "string", "minLength": 1 },
    "review_base_sha": { "$ref": "#/$defs/gitOid" },
    "review_head_sha": { "$ref": "#/$defs/gitOid" },
    "max_repair_round": { "type": "integer", "minimum": 0, "maximum": 2 },
    "methodology_enforcement": { "enum": ["required", "advisory"] },
    "evidence_completeness": { "enum": ["complete", "advisory_incomplete"] },
    "evidence_warnings": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }, "uniqueItems": true },
    "path_mapping_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "matched_profiles": { "type": "array", "items": { "enum": ["fast", "impacted", "full", "governance"] }, "uniqueItems": true },
    "matched_paths_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baseline_sha": { "$ref": "#/$defs/gitOid" },
    "remaining_risk_status": { "enum": ["none", "recorded"] },
    "remaining_risk_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "closed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "evidenceTarget": {
      "type": "string",
      "pattern": "^docs/(?:change_packs/CPK-|closure/CR-)[A-Za-z0-9._-]+\\.md$"
    }
  }
}
